# Copy this file to `.env` in the server/ folder and fill in real values.
# Never commit the real `.env` file to version control.

# ── MongoDB ──────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/whiteboard
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/whiteboard?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://priyanshmathuraisc_db_user:xmc39tbR1lvZwfjk@cluster0.pp0dodh.mongodb.net/?appName=Cluster0

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS + Socket.IO).
# This is also the base URL used to build password-reset links.
CLIENT_URL=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# ── Outgoing email (forgot-password) ────────────────────────────────────
# Any SMTP provider works (Gmail App Password, SendGrid, Mailgun, Postmark,
# Amazon SES, etc). If these are left blank, reset links are printed to the
# server console instead of emailed — fine for local dev, not for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Whiteboard <no-reply@yourdomain.com>"
